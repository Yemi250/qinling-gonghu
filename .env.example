# Copy to .env; change the password (12+ characters) before login.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=replace-with-a-local-demo-password
# Default minimum stays at 12; local demonstrations may explicitly configure 8 or more.
DEMO_ADMIN_MIN_PASSWORD_LENGTH=12
# Relative to the repository root when launched using the README commands.
DATA_DIR=./data
# D implements backend.app.ai.provider; these are server-side settings only.
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3-vl-plus
AI_API_KEY=
AI_TIMEOUT_SECONDS=60
MAX_UPLOAD_BYTES=10485760
# Visitor sessions remain separate from the configured administrator.
VISITOR_SESSION_HOURS=168
# HTTPS requests set Secure automatically; enable explicitly behind HTTPS reverse proxies.
VISITOR_COOKIE_SECURE=false
